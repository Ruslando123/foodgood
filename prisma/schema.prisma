generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  phone      String?  @unique
  telegramId String?  @unique
  name       String?
  role       String   @default("CUSTOMER") // CUSTOMER | MERCHANT
  createdAt  DateTime @default(now())

  venues        Venue[]
  orders        Order[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  address     String
  lat         Float
  lng         Float
  category    String   @default("CAFE") // CAFE | BAKERY | SUPERMARKET | RESTAURANT
  photo       String   @default("🍽️") // emoji or image URL
  ownerId     String
  createdAt   DateTime @default(now())

  owner User  @relation(fields: [ownerId], references: [id])
  bags  Bag[]
}

model Bag {
  id            String   @id @default(cuid())
  venueId       String
  title         String
  description   String   @default("")
  price         Int // sale price, KZT
  originalPrice Int // estimated original value, KZT
  quantityTotal Int
  quantityLeft  Int
  pickupStart   DateTime
  pickupEnd     DateTime
  status        String   @default("ACTIVE") // ACTIVE | SOLD_OUT | EXPIRED | CANCELLED
  createdAt     DateTime @default(now())

  venue  Venue   @relation(fields: [venueId], references: [id])
  orders Order[]

  @@index([status, pickupEnd])
}

model Order {
  id                 String    @id @default(cuid())
  bagId              String
  userId             String
  quantity           Int       @default(1)
  totalPrice         Int // KZT
  platformFee        Int // KZT, snapshot at purchase time
  status             String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | CAPTURE_PENDING | COMPLETED | REFUND_PENDING | CANCELLED | EXPIRED
  refundTargetStatus String? // CANCELLED | EXPIRED; сохраняется для повторного refund
  pickupCode         String    @unique
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  bag           Bag            @relation(fields: [bagId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  payment       Payment?
  paymentEvents PaymentEvent[]

  @@index([userId, status])
  @@index([bagId, status])
  @@index([createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  provider    String   @default("mock")
  providerRef String?
  amount      Int // KZT
  status      String   @default("PENDING_HOLD") // PENDING_HOLD | HELD | CAPTURED | REFUNDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order      Order              @relation(fields: [orderId], references: [id])
  events     PaymentEvent[]
  operations PaymentOperation[]
}

model PaymentOperation {
  id             String    @id @default(cuid())
  paymentId      String
  type           String // HOLD | CAPTURE | REFUND
  idempotencyKey String    @unique
  status         String    @default("PENDING") // PENDING | PROCESSING | RETRY | SUCCEEDED | NEEDS_REVIEW
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, type])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model PaymentEvent {
  id           String   @id @default(cuid())
  paymentId    String?
  orderId      String?
  provider     String
  providerRef  String?
  type         String // HOLD | CAPTURE | REFUND | WEBHOOK | RECONCILIATION
  status       String // SUCCEEDED | FAILED | PENDING
  amount       Int?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([provider, providerRef])
  @@index([type, status, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String?
  channel     String // SMS | TELEGRAM | PUSH | EMAIL
  recipient   String
  type        String
  status      String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  payloadJson String    @default("{}")
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([channel, status, createdAt])
  @@index([type, createdAt])
}
