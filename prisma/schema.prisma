generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String?  @unique
  telegramId            String?  @unique
  name                  String?
  role                  String   @default("CUSTOMER") // CUSTOMER | MERCHANT
  status                String   @default("ACTIVE") // ACTIVE | BLOCKED
  notificationReminders Boolean  @default(true)
  notificationOffers    Boolean  @default(true)
  sessionVersion        Int      @default(0)
  createdAt             DateTime @default(now())

  venues        Venue[]
  orders        Order[]
  auditLogs     AuditLog[]
  notifications Notification[]
  favorites     Favorite[]
  reviews       Review[]
}

model SystemState {
  key       String   @id
  valueJson String   @default("{}")
  updatedAt DateTime @updatedAt
}

model OtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  activeKey   String?   @unique
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

/// Short-lived handoff between the website and a private Telegram bot chat.
/// The bot verifies ownership of the entered phone through request_contact
/// before it is allowed to deliver an OTP.
model TelegramLoginRequest {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  phone      String
  telegramId String?
  status     String    @default("PENDING") // PENDING | WAITING_CONTACT | CODE_SENT | CONSUMED
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, status, createdAt(sort: Desc)])
  @@index([telegramId, status, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Venue {
  id               String                                @id @default(cuid())
  name             String
  description      String                                @default("")
  address          String
  lat              Float
  lng              Float
  location         Unsupported("geography(Point,4326)")?
  cityId           String                                @default("almaty")
  category         String                                @default("CAFE") // CAFE | BAKERY | SUPERMARKET | RESTAURANT
  photo            String                                @default("🍽️") // emoji or image URL
  contactPhone     String                                @default("")
  openingHours     String                                @default("")
  twoGisUrl        String                                @default("")
  status           String                                @default("ACTIVE") // ACTIVE | SUSPENDED
  suspensionReason String?
  ownerId          String
  createdAt        DateTime                              @default(now())
  ratingSum        Int                                   @default(0)
  ratingCount      Int                                   @default(0)
  ratingAverage    Float                                 @default(0)

  owner     User       @relation(fields: [ownerId], references: [id])
  bags      Bag[]
  favorites Favorite[]
  reviews   Review[]

  @@index([cityId, status])
  @@index([ownerId])
  @@index([status])
  @@index([location], type: Gist, map: "Venue_location_gist_idx")
}

model Bag {
  id            String   @id @default(cuid())
  venueId       String
  title         String
  description   String   @default("")
  allergens     String   @default("") // possible allergens, free-text label shown to customers
  price         Int // sale price, KZT
  originalPrice Int // estimated original value, KZT
  quantityTotal Int
  quantityLeft  Int
  pickupStart   DateTime
  pickupEnd     DateTime
  status        String   @default("ACTIVE") // ACTIVE | SOLD_OUT | EXPIRED | CANCELLED
  createdAt     DateTime @default(now())

  venue  Venue   @relation(fields: [venueId], references: [id])
  orders Order[]

  @@index([status, pickupEnd])
  @@index([venueId, createdAt(sort: Desc)])
}

model Order {
  id                  String    @id @default(cuid())
  bagId               String
  userId              String
  quantity            Int       @default(1)
  totalPrice          Int // KZT
  platformFee         Int // KZT, snapshot at purchase time
  paymentMethod       String    @default("ONLINE") // ONLINE | PAY_AT_PICKUP
  status              String    @default("PENDING_PAYMENT") // RESERVED | PENDING_PAYMENT | PAID | READY_FOR_PICKUP | CAPTURE_PENDING | COMPLETED | REFUND_PENDING | CANCELLED | EXPIRED
  refundTargetStatus  String? // CANCELLED | EXPIRED; сохраняется для повторного refund
  pickupCode          String    @unique
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
  supportStatus       String    @default("NONE") // NONE | OPEN | RESOLVED
  supportNote         String    @default("")
  idempotencyRecordId String?   @unique

  bag               Bag                  @relation(fields: [bagId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  payment           Payment?
  paymentEvents     PaymentEvent[]
  outboxMessages    OutboxMessage[]
  review            Review?
  idempotencyRecord OrderIdempotencyKey? @relation(fields: [idempotencyRecordId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([bagId, status])
  @@index([createdAt])
  @@index([supportStatus, supportOpenedAt])
}

/// Append-only product analytics used by the internal funnel dashboard.
/// Entity ids are deliberately stored as scalar snapshots so historical
/// events remain queryable if operational records are later archived.
model ProductEvent {
  id           String   @id @default(cuid())
  name         String
  userId       String?
  anonymousId  String?
  venueId      String
  bagId        String
  orderId      String?
  amount       Int
  platformFee  Int      @default(0)
  quantity     Int      @default(1)
  clientSource String   @default("direct")
  dedupeKey    String?  @unique
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([name, createdAt])
  @@index([venueId, createdAt])
  @@index([bagId, createdAt])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  provider    String   @default("mock")
  providerRef String?
  amount      Int // KZT
  status      String   @default("PENDING_HOLD") // PENDING_HOLD | HELD | CAPTURED | REFUNDED | FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order      Order              @relation(fields: [orderId], references: [id])
  events     PaymentEvent[]
  operations PaymentOperation[]
}

model PaymentOperation {
  id             String    @id @default(cuid())
  paymentId      String
  type           String // HOLD | CAPTURE | REFUND
  idempotencyKey String    @unique
  status         String    @default("PENDING") // PENDING | PROCESSING | WAITING_PROVIDER | RETRY | SUCCEEDED | NEEDS_REVIEW
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payment        Payment         @relation(fields: [paymentId], references: [id])
  events         PaymentEvent[]
  outboxMessages OutboxMessage[]

  @@unique([paymentId, type])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model PaymentEvent {
  id           String   @id @default(cuid())
  paymentId    String?
  operationId  String?  @unique
  orderId      String?
  provider     String
  providerRef  String?
  type         String // HOLD | CAPTURE | REFUND | WEBHOOK | RECONCILIATION
  status       String // SUCCEEDED | FAILED | PENDING
  amount       Int?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  payment   Payment?          @relation(fields: [paymentId], references: [id])
  operation PaymentOperation? @relation(fields: [operationId], references: [id])
  order     Order?            @relation(fields: [orderId], references: [id])

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([provider, providerRef])
  @@index([type, status, createdAt])
}

model OutboxMessage {
  id             String    @id @default(cuid())
  operationId    String
  orderId        String?
  type           String
  payloadJson    String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  operation PaymentOperation @relation(fields: [operationId], references: [id])
  order     Order?           @relation(fields: [orderId], references: [id])

  @@unique([operationId, type])
  @@index([status, nextAttemptAt])
}

/// Durable idempotency boundary for POST /api/orders.  `key` includes the user
/// id, so a customer cannot observe another customer's previous response.
model OrderIdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  fingerprint String
  status      String   @default("PROCESSING") // PROCESSING | SUCCEEDED | FAILED
  resultJson  String?
  ownerToken  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order?

  @@index([expiresAt])
  @@index([status, expiresAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String?
  channel     String // SMS | TELEGRAM | PUSH | EMAIL
  recipient   String
  type        String
  status      String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  payloadJson String    @default("{}")
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  readAt      DateTime?
  dedupeKey   String?   @unique

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([channel, status, createdAt])
  @@index([type, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([userId, venueId])
  @@index([userId, createdAt])
  @@index([venueId, userId])
}

/// Durable batch work created by short HTTP transactions and consumed by
/// independently scalable notification/refund workers.
model BatchJob {
  id               String    @id @default(cuid())
  queue            String
  type             String
  payloadJson      String    @default("{}")
  dedupeKey        String?   @unique
  status           String    @default("PENDING") // PENDING | PROCESSING | RETRY | SUCCEEDED | FAILED
  failureAttempts  Int       @default(0)
  batchesProcessed Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([queue, status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model Review {
  id               String   @id @default(cuid())
  orderId          String   @unique
  userId           String
  venueId          String
  rating           Int
  comment          String   @default("")
  moderationStatus String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId, moderationStatus, createdAt])
  @@index([userId, createdAt])
}
