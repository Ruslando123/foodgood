# PostgreSQL connection string. Keep production secrets outside version control.
DATABASE_URL="postgresql://foodgood:foodgood@localhost:5432/foodgood?schema=public"
# Direct PostgreSQL URL used only by migrations; never point this at PgBouncer.
DIRECT_URL="postgresql://foodgood:foodgood@localhost:5432/foodgood?schema=public"
# Per-process pool cap. Keep the sum across web and workers below the shared
# PgBouncer/PostgreSQL connection budget, with at least 20% headroom.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=10
# DATABASE_PGBOUNCER=true
# Redis is used for distributed rate limits and short idempotency caching.
# PostgreSQL remains the durable order/idempotency source of truth.
# REDIS_URL="redis://localhost:6379"
# Production requires two different secrets of at least 32 bytes each.
SESSION_SECRET="change-me"
OTP_SECRET="change-me-separately"
CRON_SECRET="change-me-too"
APP_BASE_URL="http://localhost:3000"
# Pilot mode: the venue accepts payment and issues the receipt at pickup.
# Switch to ONLINE only after a real provider and payments worker are ready.
PAYMENT_MODE=PAY_AT_PICKUP
# Номер главного администратора в международном формате. При входе с ним
# пользователь получает роль ADMIN и сразу попадает в /admin/venues.
ADMIN_PHONE="+77010000003"
# Local-development fallback. Production should use S3-compatible storage.
# VENUE_UPLOAD_DIR="/var/lib/foodgood/venue-photos"
# S3_BUCKET=foodgood
# S3_REGION=auto
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false
# METRICS_SECRET=change-me
# WORKER_METRICS_PORT=9100
# Only an isolated staging blueprint may set both values to enable mock-provider fault control.
LOAD_TEST_MODE=false
# LOAD_TEST_CONTROL_SECRET=staging-only-secret
# The demo code 0000 works only outside production. Set this to true to test the SMS adapter locally.
# FOODGOOD_DISABLE_DEV_OTP=true

# Mobizon Kazakhstan SMS API.
# MOBIZON_API_KEY=change-me
# MOBIZON_SENDER=FoodGood

# Telegram is explicitly disabled until both a flag and token are configured.
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABC-...

# Safety valve for demos only. Never enable this when accepting real money.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# Freedom Pay Merchant API. Production requires manual clearing for hold/capture.
# FREEDOM_PAY_MERCHANT_ID=123456
# FREEDOM_PAY_SECRET_KEY=provider-issued-secret
# FREEDOM_PAY_TEST_MODE=true
# FREEDOM_PAY_API_URL=https://api.freedompay.kz
