# PostgreSQL connection string. Keep production secrets outside version control.
DATABASE_URL="postgresql://foodgood:foodgood@localhost:5432/foodgood?schema=public"
SESSION_SECRET="change-me"
OTP_SECRET="change-me-separately"
CRON_SECRET="change-me-too"
# Номер главного администратора в международном формате. При входе с ним
# пользователь получает роль ADMIN и сразу попадает в /admin/venues.
ADMIN_PHONE="+77010000003"
# Каталог для загруженных владельцами фотографий. На своём сервере укажите
# постоянный диск, который сохраняется между обновлениями приложения.
# VENUE_UPLOAD_DIR="/var/lib/foodgood/venue-photos"
# The demo code 0000 works only outside production. Set this to true to test the SMS adapter locally.
# FOODGOOD_DISABLE_DEV_OTP=true

# Mobizon Kazakhstan SMS API.
# MOBIZON_API_KEY=change-me
# MOBIZON_SENDER=FoodGood

# Telegram is explicitly disabled until both a flag and token are configured.
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABC-...

# Safety valve for demos only. Never enable this when accepting real money.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
