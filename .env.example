# PostgreSQL connection string. Keep production secrets outside version control.
DATABASE_URL="postgresql://foodgood:foodgood@localhost:5432/foodgood?schema=public"
# Direct PostgreSQL URL used only by migrations; never point this at PgBouncer.
DIRECT_URL="postgresql://foodgood:foodgood@localhost:5432/foodgood?schema=public"
# Per-process pool cap. Keep the sum across web and workers below the shared
# PgBouncer/PostgreSQL connection budget, with at least 20% headroom.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=10
# DATABASE_PGBOUNCER=true
# Redis is used for distributed rate limits and short idempotency caching.
# PostgreSQL remains the durable order/idempotency source of truth.
# REDIS_URL="redis://localhost:6379"
# Production always requires Redis; this flag applies the same strict health rule in staging.
REDIS_REQUIRED=true
# Production requires two different secrets of at least 32 bytes each.
SESSION_SECRET="change-me"
OTP_SECRET="change-me-separately"
APP_BASE_URL="http://localhost:3000"
# FoodGood creates reservations only. The venue accepts payment and issues the receipt.
# Номер главного администратора в международном формате. При входе с ним
# пользователь получает роль ADMIN и сразу попадает в /admin/venues.
ADMIN_PHONE="+77010000003"
# Local-development fallback. Production should use S3-compatible storage.
# VENUE_UPLOAD_DIR="/var/lib/foodgood/venue-photos"
# S3_BUCKET=foodgood
# S3_REGION=auto
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false
# METRICS_SECRET=change-me
# WORKER_METRICS_PORT=9100
# The demo code 0000 works only outside production. Set this to true to test Telegram OTP locally.
# FOODGOOD_DISABLE_DEV_OTP=true
# Public star ratings and legacy reviews remain disabled by default. Private
# structured post-pickup feedback does not depend on this flag.
NEXT_PUBLIC_PUBLIC_RATINGS_ENABLED=false

# Telegram is explicitly disabled until its flags and credentials are configured.
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_OTP_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_BOT_USERNAME=FoodGoodBot
# Generate a random 32+ character value and keep it secret.
# TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-secret
