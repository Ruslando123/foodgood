{
  "name": "foodgood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "worker:expiry": "tsx scripts/worker.ts expiry",
    "worker:notifications": "tsx scripts/worker.ts notifications",
    "load:k6": "k6 run load/k6.js",
    "load:k6:normal": "k6 run -e LOAD_PROFILE=normal load/k6.js",
    "load:k6:hot": "k6 run -e LOAD_PROFILE=hot load/k6.js",
    "load:k6:ramp": "k6 run -e LOAD_PROFILE=ramp load/k6.js",
    "load:k6:soak": "k6 run -e LOAD_PROFILE=soak load/k6.js",
    "load:k6:staging": "k6 run load/k6-staging.js",
    "load:seed": "tsx scripts/seed-load.ts",
    "load:check": "tsx scripts/check-load-invariants.ts",
    "load:check:normal": "LOAD_PROFILE=normal tsx scripts/check-load-invariants.ts",
    "load:check:hot": "LOAD_PROFILE=hot tsx scripts/check-load-invariants.ts",
    "load:check:ramp": "LOAD_PROFILE=ramp tsx scripts/check-load-invariants.ts",
    "load:check:soak": "LOAD_PROFILE=soak tsx scripts/check-load-invariants.ts",
    "ratings:reconcile": "tsx scripts/reconcile-ratings.ts",
    "jobs:backfill-reminders": "tsx scripts/backfill-reminders.ts",
    "telegram:webhook": "node --env-file=.env scripts/setup-telegram-webhook.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "staging:failover": "node scripts/staging-failover-check.mjs",
    "staging:k6:check": "node scripts/check-k6-summary.mjs",
    "staging:restore": "node scripts/verify-backup-restore.mjs",
    "test": "node scripts/test.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@prisma/client": "^6.19.3",
    "@tabler/icons-react": "^3.44.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "next": "15.5.20",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/k6": "^2.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
